# --- Backend (server.ts) ---
PORT=3000

# Provedor de IA ativo: "gemini" (padrão), "claude", "gpt", ou "mock"
# (mock não depende de chave nenhuma — útil para testar a esteira
# completa app -> MCP -> services sem custo/chave de API).
LLM_PROVIDER=mock

GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY=

# Lista separada por vírgula, tentados em ordem. Confira os IDs atuais em
# https://docs.anthropic.com/en/docs/about-claude/model-deprecations
CLAUDE_MODEL=claude-sonnet-4-6,claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=

# Lista separada por vírgula. Confira os IDs atuais em
# https://platform.openai.com/docs/models
OPENAI_MODEL=gpt-4o-mini,gpt-4o
OPENAI_API_KEY=

# URLs dos servidores MCP (hostnames do Docker Compose de mcp/, ou
# localhost:PORTA se estiver rodando fora do Docker)
MCP_CURSOS_URL=http://mcp_cursos:8000/mcp
MCP_MATRICULAS_URL=http://mcp_matriculas:8000/mcp
MCP_RECEITAS_URL=http://mcp_receitas:8000/mcp

MCP_CURSOS_URL_DEV=http://localhost:8001/mcp
MCP_MATRICULAS_URL_DEV=http://localhost:8002/mcp
MCP_RECEITAS_URL_DEV=http://localhost:8003/mcp

# --- Frontend (Vite, injetado em build/dev) ---
# URLs públicas dos services, acessadas diretamente pelo NAVEGADOR na aba
# "Informações" — por isso usam localhost/porta publicada, não hostname
# interno do Docker (o navegador não resolve hostnames de containers).
VITE_SERVICE_CURSOS_URL=http://localhost:3001
VITE_SERVICE_MATRICULAS_URL=http://localhost:3002
VITE_SERVICE_RECEITAS_URL=http://localhost:3003

# --- Cache semântico ---
# Só a string "true" liga o cache. Ausente ou outro valor = desligado.
CACHE_ENABLED=true
# Limiar de cosseno (vetores L2-normalizados). Default 0.90.
# Mock bag-of-words: paráfrase "cursos de massas quais" vs "quais cursos de massas" = 1.0.
CACHE_SIMILARITY_THRESHOLD=0.90
CACHE_TTL_MINUTES=60
CACHE_DB_PATH=./data/cache.sqlite

# Embeddings independentes de LLM_PROVIDER: "gemini" | "openai" | "mock"
# Ausente = mock. Sem chave: o boot não lança; embed falha e o chat segue como MISS.
EMBEDDING_PROVIDER=mock
# Vazio = default do adapter (gemini-embedding-001 / text-embedding-3-small / mock-bow-256).
# conferir na doc oficial antes de preencher.
EMBEDDING_MODEL=

# --- LLM as a judge ---
# Só a string "true" liga o juiz. Ausente ou outro valor = desligado
# (o .env antigo não quebra o chat).
JUDGE_ENABLED=true
# mock | gemini | claude | gpt. Use provedor DIFERENTE de LLM_PROVIDER.
# gemini/claude/gpt reusam a chave já existente (GEMINI_API_KEY,
# ANTHROPIC_API_KEY, OPENAI_API_KEY). Não coloque chave aqui.
JUDGE_PROVIDER=mock
JUDGE_MODEL=
JUDGE_MAX_REVISIONS=1
JUDGE_EVIDENCE_MAX_CHARS=6000

# Log JSONL por resposta do chat (pergunta, resposta, evidencias, veredito, fonte).
# Vazio = desligado. Ex.: ./data/eval.jsonl
EVAL_LOG_PATH=
