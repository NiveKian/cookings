# --- Backend (server.ts) ---
PORT=3000

# Provedor de IA ativo: "gemini" (padrão), "claude", "gpt", ou "mock"
# (mock não depende de chave nenhuma — útil para testar a esteira
# completa app -> MCP -> services sem custo/chave de API).
LLM_PROVIDER=mock

GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY=

# Lista separada por vírgula, tentados em ordem. Confira os IDs atuais em
# https://docs.anthropic.com/en/docs/about-claude/model-deprecations
CLAUDE_MODEL=claude-sonnet-4-6,claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=

# Lista separada por vírgula. Confira os IDs atuais em
# https://platform.openai.com/docs/models
OPENAI_MODEL=gpt-4o-mini,gpt-4o
OPENAI_API_KEY=

# URLs dos servidores MCP (hostnames do Docker Compose de mcp/, ou
# localhost:PORTA se estiver rodando fora do Docker)
MCP_CURSOS_URL=http://mcp_cursos:8000/mcp
MCP_MATRICULAS_URL=http://mcp_matriculas:8000/mcp
MCP_RECEITAS_URL=http://mcp_receitas:8000/mcp

MCP_CURSOS_URL_DEV=http://localhost:8001/mcp
MCP_MATRICULAS_URL_DEV=http://localhost:8002/mcp
MCP_RECEITAS_URL_DEV=http://localhost:8003/mcp

# --- Frontend (Vite, injetado em build/dev) ---
# URLs públicas dos services, acessadas diretamente pelo NAVEGADOR na aba
# "Informações" — por isso usam localhost/porta publicada, não hostname
# interno do Docker (o navegador não resolve hostnames de containers).
VITE_SERVICE_CURSOS_URL=http://localhost:3001
VITE_SERVICE_MATRICULAS_URL=http://localhost:3002
VITE_SERVICE_RECEITAS_URL=http://localhost:3003
