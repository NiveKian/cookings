# ============================
# Variáveis de ambiente
# ============================
# Nunca versionar .env reais — apenas os .env.example ficam no git
.env
.env.*
!.env.example
!*.env.example

# ============================
# Node.js / Bun (services e app)
# ============================
node_modules/
dist/
build/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================
# Python / uv (mcp)
# ============================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

